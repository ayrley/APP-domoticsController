{
    "type": "FACTORY",
    "version": 1,
    "network": {
        "dhcp": false,
        "dns1": "",
        "dns2": "",
        "gateway": "192.168.1.1",
        "ipAddress": "192.168.1.100",
        "netmask": "255.255.255.0"
    },
    "readers" : [
    	{
    		"name": "wiegand",
    		"location" : "/dev/idtreader_1",
    		"location_type": "LOCAL",
    		"type" : "WIEGAND",
    		"granted" : {
				"name" : "AccessGranted",
				"outputs" : [
					{
						"output_type" : "gpio",
						"output" : "out_green",
						"duration": 1000
					}
    			]
			},
    		"denied" : {
				"name" : "AccessDenied",
				"outputs" : [
					{
						"output_type" : "gpio",
						"output" : "out_red",
						"duration": 1000
					}
    			]
			}
    	}
    ],
    "actions" : [
    	{
    		"name" : "Bel",
    		"input_type" : "gpio",
    		"input" : "in_bel",
    		"outputs" : [
				{
					"output_type" : "gpio",
					"output" : "out_bel",
					"duration": 1000
				}
    		]
    	}
    ]
}
